# Copy to ".env" next to this file for local development. On the server the file lives at the instance
# root (outside "public/") with permissions 600. Never commit the real file.
#
# Settings are validated when a feature needs them, so a missing value only affects that feature.
# Once the instance is deployed, open /api/system/requirements on its address: it checks every setting below and says
# what is still missing (docs/despliegue.md).

# "local" shows error details; use "production" on servers.
APP_ENV=local

# Public address of the instance, with no path and no trailing slash. It starts every link sent by email
# (invitations, password recovery); it is never taken from the request.
APP_URL=https://app.example.com

# Path under which the API is served. The web app is served at "/" and the API at "/api".
APP_BASE_PATH=/api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soltec
DB_USER=soltec
DB_PASS=

# Secret that protects the deployment endpoints (migrations, diagnostics). At least 32 characters;
# generate one with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Without it the deployment endpoints stay disabled.
DEPLOY_TOKEN=

# Secret that signs the access tokens (ADR-0012). At least 32 characters, different on every instance; generate one
# like DEPLOY_TOKEN. Without it, sign-in answers 503 auth_not_configured. Changing it signs everybody out.
JWT_SECRET=

# Outgoing mail (ADR-0013). Validated only when a message is sent.
# "smtp" (recommended): authenticated SMTP with a dedicated mailbox. "mail": PHP mail() through the server's MTA.
MAIL_DRIVER=smtp
MAIL_HOST=
# 465 with ssl, 587 with tls. Defaults to 465 (587 when MAIL_ENCRYPTION=tls).
MAIL_PORT=465
# ssl, tls or none
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be a real mailbox of the authenticated domain; providers rewrite the sender otherwise.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Soltec
# Optional: where replies go (a person, since the sender is a no-reply mailbox).
MAIL_REPLY_TO=

