#!/usr/bin/env php
<?php

declare(strict_types=1);

use Soltec\Kernel\Bootstrap;
use Soltec\Modules\Access\Console\CreateAdminCommand;
use Soltec\Modules\Access\Console\StdioConsole;
use Soltec\Modules\Notifications\Console\NotificationsRunCommand;

// Console entry point, uploaded with the API: php api/bin/console <command>
if (PHP_SAPI !== 'cli') {
    exit(1);
}

$appRoot = dirname(__DIR__);
require $appRoot . '/vendor/autoload.php';

$commands = [
    CreateAdminCommand::NAME => CreateAdminCommand::class,
    NotificationsRunCommand::NAME => NotificationsRunCommand::class,
];
$command = $argv[1] ?? '';
if (!isset($commands[$command])) {
    fwrite(STDERR, sprintf("Usage: php bin/console <%s>\n", implode('|', array_keys($commands))));
    exit(1);
}

$container = Bootstrap::createContainer($appRoot);
$io = new StdioConsole();

try {
    $code = $container->get($commands[$command])->run($io);
} catch (Throwable $error) {
    fwrite(STDERR, sprintf("Failed: %s\n", $error->getMessage()));
    $code = 1;
}

exit($code);
