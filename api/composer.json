{
    "name": "soltec/api",
    "description": "CRM-ERP API (PHP 8.3 + Slim 4)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "doctrine/dbal": "^4.2",
        "firebase/php-jwt": "^7.0",
        "monolog/monolog": "^3.7",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "robmorgan/phinx": "^0.16",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/yaml": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Soltec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Soltec\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.6"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "check": ["@lint", "@analyse", "@test"]
    }
}
