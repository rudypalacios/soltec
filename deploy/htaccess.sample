# Copy this file to "public/.htaccess" in the instance folder of the server, once. The deployment
# never uploads nor overwrites it: it is specific to the server.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hosts that run PHP as CGI/FastCGI drop the Authorization header; pass it on for the API tokens.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The API: every /api/... request goes to the front controller.
    RewriteCond %{REQUEST_URI} !^/api/index\.php$
    RewriteRule ^api(/.*)?$ api/index.php [L]

    # The web app: anything that is not a real file or folder goes to the single-page app.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    # Enable once HTTPS works on every subdomain of the instance:
    # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Never serve files that start with a dot.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
